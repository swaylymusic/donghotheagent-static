---
import BaseLayout from "../../layouts/BaseLayout.astro";

const gumroadUrl = "https://dohlee.gumroad.com/l/ontario-realtor-client-communication";
const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Ontario Realtor AI Client Communication Starter Pack",
  description:
    "A practical communication starter pack for Ontario realtors who want clearer, faster, and more consistent client communication.",
  brand: { "@type": "Brand", name: "Dongho Lee" },
  url: new URL("/ontario-realtor-client-communication/", Astro.site ?? Astro.url).toString(),
  offers: {
    "@type": "Offer",
    url: gumroadUrl,
    availability: "https://schema.org/InStock",
  },
};
---

<BaseLayout
  title="Ontario Realtor AI Client Communication Starter Pack | Dongho Lee"
  description="A practical AI communication starter pack for Ontario realtors. Get clearer client messages, follow-ups, and real estate conversations with the Ontario Realtor AI Client Communication Starter Pack."
  canonical="/ontario-realtor-client-communication/"
  image="/uploads/2025/10/profile_dongholee.jpg"
  structuredData={productStructuredData}
>
  <section class="product-hero">
    <div class="product-hero-copy">
      <p class="page-kicker">New resource for Ontario realtors</p>
      <h1>Communicate with clients clearly, confidently, and consistently.</h1>
      <p class="product-lead">
        The <strong>Ontario Realtor AI Client Communication Starter Pack</strong> helps realtors
        turn everyday client conversations into polished, useful messages—without starting from
        a blank page every time.
      </p>
      <div class="product-actions">
        <a class="button primary" href={gumroadUrl} target="_blank" rel="noopener noreferrer">Get the Starter Pack on Gumroad</a>
        <a class="button secondary" href="#inside">See what’s inside</a>
      </div>
      <p class="product-note">Built for Ontario real estate conversations · English resource · Instant access through Gumroad</p>
    </div>
    <div class="product-card" aria-label="Ontario Realtor AI Client Communication Starter Pack">
      <span class="product-card-label">STARTER PACK</span>
      <h2>Ontario Realtor<br /><em>AI Client Communication</em></h2>
      <div class="product-card-line"></div>
      <p>Practical prompts and communication support for real client work.</p>
      <span class="product-card-mark">DL</span>
    </div>
  </section>

  <section class="product-intro" id="inside">
    <p class="page-kicker">Less time rewriting. More time serving clients.</p>
    <h2>Make the next message easier to send.</h2>
    <p>
      Real estate communication happens all day: new inquiries, showing follow-ups, offer updates,
      reminders, explanations, and difficult conversations. This starter pack gives you a practical
      starting point so your messages sound professional, human, and aligned with the Ontario real
      estate context.
    </p>
    <div class="benefit-grid">
      <article><span>01</span><h3>Start faster</h3><p>Move from a rough thought to a usable client message in less time.</p></article>
      <article><span>02</span><h3>Stay consistent</h3><p>Keep your tone clear and professional across email, text, and follow-up.</p></article>
      <article><span>03</span><h3>Communicate with care</h3><p>Explain next steps and expectations in language clients can actually understand.</p></article>
    </div>
  </section>

  <section class="product-split">
    <div>
      <p class="page-kicker">Made for the real work</p>
      <h2>Useful when the conversation matters.</h2>
      <p>Use it as a working reference when you are preparing a message, checking your tone, or looking for a better way to explain the next step.</p>
    </div>
    <ul>
      <li>New-lead and consultation follow-ups</li>
      <li>Showing confirmations and post-showing messages</li>
      <li>Offer, negotiation, and transaction updates</li>
      <li>Clearer explanations for buyers, sellers, and newcomers</li>
      <li>AI-assisted drafting that still sounds like you</li>
    </ul>
  </section>

  <section class="product-cta">
    <div>
      <p class="page-kicker">Available now</p>
      <h2>Give your client communication a stronger starting point.</h2>
      <p>Explore the Ontario Realtor AI Client Communication Starter Pack on Gumroad.</p>
    </div>
    <a class="button primary" href={gumroadUrl} target="_blank" rel="noopener noreferrer">View on Gumroad</a>
  </section>

  <style>
    .product-hero{max-width:var(--container);margin:0 auto;padding:72px 18px 56px;display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:72px;align-items:center}.product-hero h1{max-width:700px;font-family:Georgia,"Times New Roman",serif;font-size:48px;line-height:1.08;letter-spacing:0;color:var(--navy);margin:0 0 18px}.product-lead{max-width:650px;font-size:16px;line-height:1.75;color:#17283a}.product-actions{display:flex;flex-wrap:wrap;gap:10px;margin:24px 0 12px}.product-note{font-size:13px;color:#526b80}.product-card{min-height:330px;padding:28px;border:1px solid var(--border);border-radius:8px;background:var(--navy);color:#fff;box-shadow:0 15px 32px rgba(15,23,42,.12);display:flex;flex-direction:column;justify-content:space-between}.product-card-label{font-size:12px;letter-spacing:.12em;color:#d5e1ea}.product-card h2{font-family:Georgia,"Times New Roman",serif;font-size:34px;line-height:1.12;margin:28px 0}.product-card h2 em{color:#d7c98b;font-style:normal}.product-card-line{height:1px;background:rgba(255,255,255,.35)}.product-card p{max-width:260px;line-height:1.6;color:#f2f6f8}.product-card-mark{font-size:22px;font-weight:700;letter-spacing:.12em;color:#d7c98b}.product-intro{max-width:var(--container);margin:0 auto;padding:18px 18px 58px}.product-intro h2,.product-split h2,.product-cta h2{font-family:Georgia,"Times New Roman",serif;font-size:32px;line-height:1.14;color:var(--navy);margin:0 0 14px}.product-intro>p:not(.page-kicker){max-width:760px;font-size:15px;line-height:1.75;color:#17283a}.benefit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:28px}.benefit-grid article{border:1px solid var(--border);border-radius:8px;background:#fff;padding:18px 16px;box-shadow:0 12px 26px rgba(15,23,42,.04)}.benefit-grid span{display:block;font-family:Georgia,"Times New Roman",serif;color:var(--gold);font-size:22px;font-weight:800;line-height:1;margin-bottom:12px}.benefit-grid h3{font-size:17px;color:var(--navy);margin:0 0 8px}.benefit-grid p{font-size:14px;line-height:1.6;color:#3d5368}.product-split{max-width:var(--container);margin:0 auto 42px;padding:28px 30px;border:1px solid var(--border);border-radius:8px;background:#f8fbfd;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}.product-split p{font-size:15px;line-height:1.7;color:#17283a}.product-split ul{margin:0;padding:0;list-style:none}.product-split li{padding:10px 0;border-bottom:1px solid var(--border);font-size:14px;color:#17283a}.product-split li::before{content:'→';color:var(--gold);margin-right:12px}.product-cta{max-width:var(--container);margin:0 auto;padding:18px 18px 72px;display:flex;justify-content:space-between;align-items:center;gap:26px}.product-cta p:not(.page-kicker){font-size:15px;line-height:1.7;color:#17283a}.product-cta .button{white-space:nowrap}@media(max-width:760px){.product-hero{grid-template-columns:1fr;gap:34px;padding-top:54px}.product-hero h1{font-size:38px;line-height:1.08}.product-card{min-height:290px}.benefit-grid,.product-split{grid-template-columns:1fr}.product-cta{display:block}.product-cta .button{display:inline-flex;margin-top:1rem}}
  </style>
</BaseLayout>
